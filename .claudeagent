{
  "name": "autonomous-builder",
  "version": "6.0.0",
  "description": "5-Agent Autonomous Build System - Reads requirements documents and builds complete software projects through coordinated multi-agent phases",
  "entrypoint": "agent_main.md",
  "config": {
    "claude_dir": ".claude",
    "config_file": ".claude/agents/config.yaml",
    "agents_file": ".claude/agents/agents.yaml",
    "max_cycles_per_phase": 3,
    "validator_mode": "pause_and_ask"
  },
  "parameters": {
    "input": {
      "type": "string",
      "description": "Path to a .md file OR a folder containing .md files",
      "required": true
    },
    "mode": {
      "type": "string",
      "description": "Processing mode: 'sequential' or 'parallel'",
      "default": "sequential",
      "enum": ["sequential", "parallel"]
    },
    "max_cycles": {
      "type": "integer",
      "description": "Maximum retry cycles per phase (overrides config)",
      "default": 3
    },
    "validator_mode": {
      "type": "string",
      "description": "Validator behavior: 'pause_and_ask' or 'assume_and_log'",
      "default": "pause_and_ask",
      "enum": ["pause_and_ask", "assume_and_log"]
    }
  },
  "usage_examples": [
    "Process all documents in a folder: autonomous-builder --input ./pocs",
    "Process single document: autonomous-builder --input ./pocs/my-app.md",
    "Process with custom settings: autonomous-builder --input ./pocs --max_cycles 5 --validator_mode assume_and_log",
    "Parallel processing: autonomous-builder --input ./pocs --mode parallel"
  ]
}
